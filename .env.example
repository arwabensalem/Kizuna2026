DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_DATABASE=kizuna
MYSQL_USER=kizuna
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Set to 1 only before MySQL is installed. The hackathon database is MySQL.
# KIZUNA_USE_SQLITE=1

# After migrate, create an operator account. The command asks for the password.
# Do not put that password in this file.
#   .\.venv\Scripts\Activate.ps1
#   python manage.py createsuperuser
# Then open http://127.0.0.1:8000/admin/

# Négociation simulée de la Bourse (acheteur étranger joué par une IA + traduction).
# Mettez la clé dans votre fichier .env (jamais dans le code ni dans git).
# Sans clé, la page fonctionne en mode démo hors ligne.
# Option 1, OpenRouter :
# OPENROUTER_API_KEY=
# KIZUNA_AI_MODEL=nom/du-modele
# KIZUNA_AI_FALLBACK_MODELS=autre/modele-1,autre/modele-2
# Option 2, Claude (si OPENROUTER_API_KEY est vide) :
# ANTHROPIC_API_KEY=
# KIZUNA_AI_MODEL=claude-opus-5-5

